{
  "name": "test-stpr-ui-kit",
  "version": "1.0.0",
  "description": "UI-kit package",
  "license": "MIT",
  "author": "Mochalov Ivan",
  "homepage": "https://stroimprosto.mos.ru/storybook?path=/",
  "repository": {
    "type": "git",
    "url": "https://gitflic.ru/project/arnold2023/test-storybook"
  },
  "bugs": {
    "url": "https://gitflic.ru/project/arnold2023/test-storybook/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "main": "./dist/test-stpr-ui-kit.js",
  "module": "./dist/test-stpr-ui-kit.js",
  "types": "./dist/test-stpr-ui-kit.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/test-stpr-ui-kit.d.ts",
      "import": "./dist/test-stpr-ui-kit.js",
      "default": "./dist/test-stpr-ui-kit.js"
    },
    "./styles/tokens.css": "./dist/styles/tokens.css"
  },
  "peerDependencies": {
    "react": "^16.9.0 || ^17 || ^18 || ^19",
    "react-dom": "^16.9.0 || ^17 || ^18 || ^19",
    "three": "^0.184.0",
    "web-ifc": "^0.0.77"
  },
  "scripts": {
    "postinstall": "node scripts/copy-web-ifc-wasm.mjs",
    "build:ignore-tsc": "vite build",
    "build:lib": "node scripts/inline-changelog.js && tsc && vite build && node scripts/build-tokens-css.mjs && tsc -p tsconfig.lib.json",
    "changelog:update": "node scripts/inline-changelog.js",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "dev:storybook": "node scripts/inline-changelog.js && storybook dev -p 6006",
    "build:storybook": "node scripts/inline-changelog.js && storybook build --output-dir storybook-static/themes/main/assets/storybook && node scripts/fix-storybook-paths.js",
    "build:storybook-pages": "node scripts/inline-changelog.js && storybook build --output-dir storybook-static-pages"
  },
  "dependencies": {
    "@mona-health/react-input-mask": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "react-datepicker": "^9.1.0",
    "react-dropzone": "^14.3.8",
    "react-responsive": "^10.0.1",
    "react-textarea-autosize": "^8.5.9"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^9.39.4",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-links": "^10.4.1",
    "@storybook/addon-onboarding": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@tsconfig/recommended": "^1.0.10",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.0.14",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/react-input-mask": "^3.0.6",
    "@types/three": "^0.184.1",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.6",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-storybook": "^10.4.1",
    "globals": "^17.4.0",
    "prettier": "^3.6.2",
    "rollup-plugin-copy": "^3.5.0",
    "sass": "^1.99.0",
    "storybook": "^10.4.1",
    "three": "^0.184.0",
    "typescript": "^6.0.3",
    "vite": "^7.2.2",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vite-plugin-svgr": "^5.2.0",
    "web-ifc": "^0.0.77"
  }
}
