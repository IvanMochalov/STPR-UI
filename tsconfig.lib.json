{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/test-stpr-ui-kit.ts",
    "src/components/**/*.ts",
    "src/components/**/*.tsx"
  ],
  "exclude": ["src/stories", "src/documentation"]
}
